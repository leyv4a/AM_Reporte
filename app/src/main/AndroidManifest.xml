<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Permiso para acceder a Internet (necesario para Retrofit) -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Permiso para leer imágenes de la galería -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!-- Permiso para Android 13+ (galería) -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ReporteCiudadano"
        android:usesCleartextTraffic="true">

        <!-- SplashActivity es la pantalla inicial -->
        <activity
            android:name=".activities.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.ReporteCiudadano.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Pantalla principal con los dos botones -->
        <activity
            android:name=".activities.MainActivity"
            android:exported="false" />

        <!-- Pantalla del formulario de reporte -->
        <activity
            android:name=".activities.ReporteActivity"
            android:exported="false" />

        <!-- Pantalla de información de contacto -->
        <activity
            android:name=".activities.ContactoActivity"
            android:exported="false" />

    </application>

</manifest>
