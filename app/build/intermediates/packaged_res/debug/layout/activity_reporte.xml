<?xml version="1.0" encoding="utf-8"?>
<!-- Layout del formulario de reporte ciudadano -->
<!-- ScrollView permite desplazarse cuando el teclado aparece -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- ===== SECCIÓN: DATOS PERSONALES ===== -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DATOS PERSONALES"
            android:textColor="#1565C0"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"/>

        <!-- Campo: Nombre del interesado -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nombre completo *"
            android:textColor="#424242"
            android:textSize="14sp"
            android:layout_marginBottom="4dp"/>

        <EditText
            android:id="@+id/etNombre"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Tu nombre completo"
            android:inputType="textPersonName|textCapWords"
            android:background="@drawable/bg_edittext"
            android:padding="12dp"
            android:layout_marginBottom="12dp"/>

        <!-- Campo: Colonia (Spinner) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Colonia *"
            android:textColor="#424242"
            android:textSize="14sp"
            android:layout_marginBottom="4dp"/>

        <Spinner
            android:id="@+id/spinnerColonia"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_spinner"
            android:padding="4dp"
            android:layout_marginBottom="12dp"/>

        <!-- Campo: Dirección -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Dirección *"
            android:textColor="#424242"
            android:textSize="14sp"
            android:layout_marginBottom="4dp"/>

        <EditText
            android:id="@+id/etDireccion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Calle, número, referencias"
            android:inputType="textMultiLine|textCapSentences"
            android:minLines="2"
            android:gravity="top"
            android:background="@drawable/bg_edittext"
            android:padding="12dp"
            android:layout_marginBottom="12dp"/>

        <!-- Campo: Celular -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Celular *"
            android:textColor="#424242"
            android:textSize="14sp"
            android:layout_marginBottom="4dp"/>

        <EditText
            android:id="@+id/etCelular"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="10 dígitos"
            android:inputType="phone"
            android:maxLength="10"
            android:background="@drawable/bg_edittext"
            android:padding="12dp"
            android:layout_marginBottom="12dp"/>

        <!-- Campo: Correo electrónico -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Correo electrónico *"
            android:textColor="#424242"
            android:textSize="14sp"
            android:layout_marginBottom="4dp"/>

        <EditText
            android:id="@+id/etCorreo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="ejemplo@correo.com"
            android:inputType="textEmailAddress"
            android:background="@drawable/bg_edittext"
            android:padding="12dp"
            android:layout_marginBottom="16dp"/>

        <!-- ===== SECCIÓN: DETALLES DEL REPORTE ===== -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DETALLES DEL REPORTE"
            android:textColor="#1565C0"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <!-- Campo: Tipo de reporte (Spinner) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tipo de reporte *"
            android:textColor="#424242"
            android:textSize="14sp"
            android:layout_marginBottom="4dp"/>

        <Spinner
            android:id="@+id/spinnerTipo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_spinner"
            android:padding="4dp"
            android:layout_marginBottom="12dp"/>

        <!-- Campo: Descripción -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Descripción *"
            android:textColor="#424242"
            android:textSize="14sp"
            android:layout_marginBottom="4dp"/>

        <EditText
            android:id="@+id/etDescripcion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Describe el problema con detalle..."
            android:inputType="textMultiLine|textCapSentences"
            android:minLines="4"
            android:gravity="top"
            android:background="@drawable/bg_edittext"
            android:padding="12dp"
            android:layout_marginBottom="16dp"/>

        <!-- ===== SECCIÓN: IMAGEN ===== -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="IMAGEN (OPCIONAL)"
            android:textColor="#1565C0"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <!-- Botón para seleccionar imagen de la galería -->
        <Button
            android:id="@+id/btnSeleccionarImagen"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="📷  Seleccionar imagen"
            android:backgroundTint="#546E7A"
            android:layout_marginBottom="8dp"/>

        <!-- Mostrar el nombre de la imagen seleccionada -->
        <TextView
            android:id="@+id/tvNombreImagen"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ninguna imagen seleccionada"
            android:textColor="#757575"
            android:textSize="13sp"
            android:gravity="center"
            android:layout_marginBottom="24dp"/>

        <!-- ===== BOTÓN ENVIAR ===== -->
        <Button
            android:id="@+id/btnEnviarReporte"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Enviar Reporte"
            android:textSize="18sp"
            android:textStyle="bold"
            android:backgroundTint="#1565C0"
            android:layout_marginBottom="16dp"/>

    </LinearLayout>

</ScrollView>
